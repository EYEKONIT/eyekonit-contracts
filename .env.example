# Private key for deployment (DO NOT commit the actual .env file)
PRIVATE_KEY=replace_with_a_new_dedicated_testnet_deployer_key
PLATFORM_ADMIN_ADDRESS=replace_with_a_safe_or_dedicated_admin_address
EXPECTED_DEPLOYER_ADDRESS=0x988d0D4f9E58913440B52B2dAa0c472E7CB7f64D

# RPC URLs
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-rpc.com
# Set to 137 only immediately before an approved Polygon mainnet deployment.
CONFIRM_POLYGON_MAINNET=

# API Keys
POLYGONSCAN_API_KEY=your_polygonscan_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Gas reporting
REPORT_GAS=false
